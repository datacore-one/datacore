#!/bin/bash
# ~/Data/sync [pull|push|status]

ACTION="${1:-pull}"
ALERT_FILE="$HOME/Data/.datacore/state/sync-alerts.log"

echo "Datacore sync: $ACTION"

sync_alert() {
    local msg="[$(date '+%Y-%m-%d %H:%M')] SYNC ALERT: $1"
    echo "$msg" >&2
    mkdir -p "$(dirname "$ALERT_FILE")"
    echo "$msg" >> "$ALERT_FILE"
}

sync_repo() {
    local repo="$1"
    local name="$2"

    if [ ! -d "$repo/.git" ]; then
        return
    fi

    # Get current branch
    local current_branch=$(git -C "$repo" branch --show-current 2>/dev/null)

    # Warn if not on main
    warn_branch() {
        if [ -n "$current_branch" ] && [ "$current_branch" != "main" ] && [ "$current_branch" != "master" ]; then
            echo "  ⚠️  On branch '$current_branch' (not main)"
        fi
    }

    # Safety check 0: refuse to PUSH from a non-default branch.
    #
    # This used to be warn_branch alone — an echo into a log nobody reads, on a
    # server, at 2am. It fired correctly for two months while 610 commits piled
    # up on ops/b17-sprint-claim in 5-plur: 52 zettels, 19 literature notes,
    # every weekly content calendar since mid-June, 15 journal entries. All
    # pushed. None on main. None visible to anyone.
    #
    # The asymmetry was the bug. This same function hard-ABORTS if a commit would
    # delete >5 files, or if one file loses >500 lines — but merely muttered when
    # the entire push was destined for a branch nobody would ever read. The second
    # is the more expensive failure, so it gets the same treatment as the first.
    #
    # Abort rather than auto-checkout: a push is not the moment to move someone's
    # HEAD out from under them. Alerting is the point — silent stranding is what
    # cost us two months.
    #
    # Legitimate feature-branch work: push it yourself, or open a PR.
    # Override for a deliberate one-off with DATACORE_SYNC_ALLOW_BRANCH=1.
    abort_if_stray_branch() {
        [ -z "$current_branch" ] && return 0
        [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ] && return 0
        [ "${DATACORE_SYNC_ALLOW_BRANCH:-0}" = "1" ] && return 0

        sync_alert "ABORT push in $name — HEAD is on '$current_branch', not the default branch. Anything pushed from here lands where no one reads it. Either merge to main, open a PR, or re-run with DATACORE_SYNC_ALLOW_BRANCH=1."
        return 1
    }

    if [ "$ACTION" = "pull" ]; then
        echo "Pulling $name..."
        warn_branch
        # Fork-and-overlay model (DIP-0001): if 'upstream' remote exists,
        # merge upstream first, then push to origin to keep fork in sync.
        if git -C "$repo" remote get-url upstream &>/dev/null; then
            git -C "$repo" fetch --all --prune 2>/dev/null
            git -C "$repo" merge upstream/main --no-edit 2>/dev/null \
                && echo "  ✓ merged upstream" \
                || echo "  ⚠️  upstream merge failed (resolve manually)"
            # NOT `|| true`. DIP-0046's opening example is this exact line
            # reporting "synced clean" for nine days while pushing nothing.
            git -C "$repo" push origin main 2>&1 | tail -1 \
                || echo "  ⚠️  push to fork FAILED (see above)"
        else
            # One transport (DIP-0046). This was `pull --rebase --autostash`:
            # the rebase stranded 610 commits on a parked branch, and an
            # autostash whose pop conflicts keeps the stash and writes conflict
            # markers into org files — that combination blocked briefing
            # delivery for three days on 2026-08-03. converge commits first
            # (findable, pushable), merges, and refuses rather than resetting.
            local out rc
            out=$(python3 "$(dirname "$0")/.datacore/lib/ledger_transport.py" \
                    converge --space "$repo" 2>&1)
            rc=$?
            if [ $rc -eq 0 ]; then
                echo "  ✓ converged"
            else
                # Distinguish what clears itself from what never will.
                case "$out" in
                    *"auth denied"*|*"host key"*|*"repo missing"*|*"autosave refused"*)
                        sync_alert "BLOCKED $name — $(echo "$out" | grep -o '\"reason\".*' | head -1)" ;;
                    *offline*|*"fetch failed"*) echo "  (offline — local work is committed, syncs later)" ;;
                    *) echo "  ⚠️  $name needs a human: $(echo "$out" | head -3 | tail -1)" ;;
                esac
            fi
        fi
    elif [ "$ACTION" = "push" ]; then
        echo "Pushing $name..."
        warn_branch
        abort_if_stray_branch || return 1
        # Stage new and modified files only — NEVER stage deletions automatically.
        # This prevents partial working copies (e.g. nightshift server) from
        # deleting files they don't have locally. Use 'git rm' for intentional deletes.
        git -C "$repo" add --ignore-removal . 2>/dev/null
        # Safety check 1: abort if commit would delete more than 5 files
        local del_count=$(git -C "$repo" diff --cached --diff-filter=D --name-only 2>/dev/null | wc -l | tr -d ' ')
        if [ "$del_count" -gt 5 ]; then
            sync_alert "ABORT push in $name — would delete $del_count files. Review: git -C $repo diff --cached --stat"
            git -C "$repo" reset HEAD 2>/dev/null
            return 1
        fi

        # Safety check 2: abort if any single modified file would lose a huge
        # number of lines. Catches the case where a script truncated a file
        # (e.g. org-workspace data-loss bug, 2026-05-16). Trips when a file
        # loses >500 lines AND those losses are >40% of its HEAD size.
        # Override with DATACORE_SYNC_FORCE=1 for intentional large changes.
        if [ "${DATACORE_SYNC_FORCE:-0}" != "1" ]; then
            local shrink_alert=""
            while IFS=$'\t' read -r added removed path; do
                # Skip binary files (- -) and new files (no HEAD version)
                [ "$added" = "-" ] && continue
                [ -z "$path" ] && continue
                # Only check modifications, not adds/deletes
                local change_type=$(git -C "$repo" diff --cached --name-status -- "$path" 2>/dev/null | awk '{print $1}')
                [ "$change_type" != "M" ] && continue
                # HEAD line count
                local head_lines=$(git -C "$repo" show "HEAD:$path" 2>/dev/null | wc -l | tr -d ' ')
                [ -z "$head_lines" ] || [ "$head_lines" -eq 0 ] && continue
                # Trip if removed > 500 AND removed/head_lines > 40%
                if [ "$removed" -gt 500 ]; then
                    # Integer percent: removed * 100 / head_lines
                    local pct=$((removed * 100 / head_lines))
                    if [ "$pct" -gt 40 ]; then
                        shrink_alert="${shrink_alert}\n  $path: -$removed lines (${pct}% of $head_lines)"
                    fi
                fi
            done < <(git -C "$repo" diff --cached --numstat 2>/dev/null)
            if [ -n "$shrink_alert" ]; then
                sync_alert "ABORT push in $name — suspicious large shrink in modified file(s):$(printf '%b' "$shrink_alert")"
                sync_alert "  Review: git -C $repo diff --cached --stat"
                sync_alert "  If intentional, retry with: DATACORE_SYNC_FORCE=1 ./sync push"
                git -C "$repo" reset HEAD 2>/dev/null
                return 1
            fi
        fi
        # Confidentiality check: if remote is a protected (public) repo, ensure no
        # forbidden paths got staged.
        local remote_url=$(git -C "$repo" remote get-url origin 2>/dev/null || echo "")
        local protected_repo=$(echo "$remote_url" | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
        if [ -n "$protected_repo" ] && [ -f "$HOME/Data/.datacore/config/public-repo-denylist.yaml" ]; then
            local is_protected=$(python3 -c "
import yaml
with open('$HOME/Data/.datacore/config/public-repo-denylist.yaml') as f:
    d = yaml.safe_load(f)
print('1' if '$protected_repo' in d.get('protected_repos', []) else '0')
" 2>/dev/null || echo "0")
            if [ "$is_protected" = "1" ]; then
                local forbidden=$(git -C "$repo" diff --cached --name-only --diff-filter=AM 2>/dev/null | python3 -c "
import sys, yaml, fnmatch
with open('$HOME/Data/.datacore/config/public-repo-denylist.yaml') as f:
    d = yaml.safe_load(f)
patterns = d.get('forbidden_paths', [])
for line in sys.stdin:
    p = line.strip()
    if not p: continue
    for pat in patterns:
        if (fnmatch.fnmatch(p, pat) or
            (pat.startswith('**/') and fnmatch.fnmatch(p, pat[3:])) or
            (pat.endswith('/**') and (p == pat[:-3] or p.startswith(pat[:-3] + '/')))):
            print(f'{p}\t{pat}')
            break
" 2>/dev/null)
                if [ -n "$forbidden" ]; then
                    sync_alert "ABORT push in $name — staged confidential paths for protected repo $protected_repo:"
                    while IFS=$'\t' read -r path pattern; do
                        sync_alert "  $path  (matched: $pattern)"
                    done <<< "$forbidden"
                    sync_alert "Move to private storage or add to .gitignore. Then retry."
                    git -C "$repo" reset HEAD 2>/dev/null
                    return 1
                fi
            fi
        fi
        # Safety check 3: a commit that FAILS must not be followed by a push that
        # reports success.
        #
        # The root repo's pre-commit hook (root-level allowlist) had been rejecting
        # every commit for an unknown length of time. This line used to be
        # `... || git commit -m ...` with no exit-code check, so a rejected commit
        # fell straight through to the push, the push had nothing new to send,
        # and sync printed its normal output. Nothing anywhere said "your work was
        # not committed" — the run was indistinguishable from a clean one.
        #
        # Same shape as the stray-branch bug above: an operation failed and the
        # tool reported a result you cannot tell apart from success.
        if ! git -C "$repo" diff --cached --quiet; then
            if ! git -C "$repo" commit -m "Sync: $(date +%Y-%m-%d)"; then
                sync_alert "ABORT push in $name — commit was rejected (likely a pre-commit hook). Staged changes are NOT saved and NOT pushed. Run: git -C $repo commit -v"
                return 1
            fi
        fi
        # Safety check 4: name the push failure. This was
        # `push 2>/dev/null || echo "(no remote or error)"`, which sent the
        # only useful text to /dev/null and printed one message for four
        # unrelated conditions — no remote, a rejected key, a non-fast-forward,
        # and a ruleset refusal all read identically, and three of them need
        # different actions. The ssh config's own comment records this line
        # failing silently "after every reboot".
        local push_out push_rc
        push_out=$(git -C "$repo" push 2>&1); push_rc=$?
        if [ $push_rc -ne 0 ]; then
            case "$push_out" in
                # Git does not print "Permission denied" every time. On repeated
                # failures within one run it drops that line and leaves only the
                # generic tail, so matching solely on it classified the first
                # blocked repo correctly and the next three as unknown — same
                # cause, two different alerts. Match the tail as well.
                *"Permission denied"*|*"Authentication failed"*|\
                *"correct access rights"*|*"Could not read from remote repository"*)
                    sync_alert "BLOCKED $name — key rejected by remote (check the key, or a VPN/exit node)" ;;
                *"Host key verification failed"*)
                    sync_alert "BLOCKED $name — remote host key not trusted" ;;
                # Ordering is load-bearing, most specific first — "fetch first"
                # is the actionable answer and must win.
                *"non-fast-forward"*|*"fetch first"*)
                    echo "  behind remote — run './sync pull' first" ;;
                # NOT a bare *protected*: this repo's own pre-push hook prints
                # "not a protected public repo — policy check skipped" on every
                # push, so that pattern matched the hook's banner and reported
                # "ruleset blocked" for two repos that were merely behind. A
                # classifier that matches its own tooling's output is worse than
                # no classifier: it is confidently wrong.
                *GH013*|*"rule violations"*|*"protected branch"*)
                    sync_alert "REFUSED $name — repository ruleset blocked this push (force-push or deletion?)" ;;
                *"does not appear to be a git repository"*|*"No configured push destination"*)
                    echo "  (no remote configured)" ;;
                *) sync_alert "PUSH FAILED $name — $(echo "$push_out" | tail -2 | head -1)" ;;
            esac
        fi
    elif [ "$ACTION" = "status" ]; then
        echo "Status: $name [$current_branch]"
        warn_branch
        git -C "$repo" status --short
    fi
}

# Root repo
sync_repo "." "root"

# All spaces (numbered folders)
for space in [0-9]-*/; do
    if [ -d "$space" ]; then
        sync_repo "$space" "space: $space"
    fi
done

# Modules (independent repos under .datacore/modules/)
for module in .datacore/modules/*/; do
    if [ -d "$module/.git" ]; then
        sync_repo "$module" "module: $(basename $module)"
    fi
done

# DIPs (independent repo)
if [ -d ".datacore/dips/.git" ]; then
    sync_repo ".datacore/dips" "dips"
fi

# All projects within spaces
#
# Code repos are NEVER auto-committed. `sync push` stages everything with
# `git add --ignore-removal .` and commits it as "Sync: <date>" — correct for
# notes and org files, wrong for a codebase. On 2026-08-09 it took an agent's
# edit to OVERVIEW.md in a project repo, committed it straight to `main`,
# pushed, and triggered a production deploy. That repo requires changes to go
# through a PR into a development branch; sync bypassed the entire flow, and
# the deploy was a side effect nobody asked for.
#
# Pull and status still run — those are safe and it is genuinely useful to see
# what is outstanding. Only push is withheld. Anything uncommitted here is
# reported so it cannot be silently stranded, which is the failure this whole
# script is otherwise built to prevent.
for space in [0-9]-*/; do
    if [ -d "$space/2-projects" ]; then
        for project in "$space"2-projects/*/; do
            if [ -d "$project/.git" ]; then
                if [ "$ACTION" = "push" ]; then
                    dirty=$(git -C "$project" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
                    unpushed=$(git -C "$project" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
                    if [ "$dirty" != "0" ] || [ "$unpushed" != "0" ]; then
                        echo "Skipping project: $(basename $project) — code repos are not auto-committed."
                        echo "  $dirty uncommitted file(s), $unpushed unpushed commit(s). Commit and push it yourself, or open a PR."
                    fi
                    continue
                fi
                sync_repo "$project" "project: $(basename $project)"
            fi
        done
    fi
done

echo "Sync complete"
