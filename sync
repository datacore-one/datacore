#!/bin/bash
# ~/Data/sync [pull|push|status]

ACTION="${1:-pull}"
ALERT_FILE="$HOME/Data/.datacore/state/sync-alerts.log"

echo "Datacore sync: $ACTION"

sync_alert() {
    local msg="[$(date '+%Y-%m-%d %H:%M')] SYNC ALERT: $1"
    echo "$msg" >&2
    mkdir -p "$(dirname "$ALERT_FILE")"
    echo "$msg" >> "$ALERT_FILE"
}

sync_repo() {
    local repo="$1"
    local name="$2"

    if [ ! -d "$repo/.git" ]; then
        return
    fi

    # Get current branch
    local current_branch=$(git -C "$repo" branch --show-current 2>/dev/null)

    # Warn if not on main
    warn_branch() {
        if [ -n "$current_branch" ] && [ "$current_branch" != "main" ] && [ "$current_branch" != "master" ]; then
            echo "  ⚠️  On branch '$current_branch' (not main)"
        fi
    }

    # Safety check 0: refuse to PUSH from a non-default branch.
    #
    # This used to be warn_branch alone — an echo into a log nobody reads, on a
    # server, at 2am. It fired correctly for two months while 610 commits piled
    # up on ops/b17-sprint-claim in 5-plur: 52 zettels, 19 literature notes,
    # every weekly content calendar since mid-June, 15 journal entries. All
    # pushed. None on main. None visible to anyone.
    #
    # The asymmetry was the bug. This same function hard-ABORTS if a commit would
    # delete >5 files, or if one file loses >500 lines — but merely muttered when
    # the entire push was destined for a branch nobody would ever read. The second
    # is the more expensive failure, so it gets the same treatment as the first.
    #
    # Abort rather than auto-checkout: a push is not the moment to move someone's
    # HEAD out from under them. Alerting is the point — silent stranding is what
    # cost us two months.
    #
    # Legitimate feature-branch work: push it yourself, or open a PR.
    # Override for a deliberate one-off with DATACORE_SYNC_ALLOW_BRANCH=1.
    abort_if_stray_branch() {
        [ -z "$current_branch" ] && return 0
        [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ] && return 0
        [ "${DATACORE_SYNC_ALLOW_BRANCH:-0}" = "1" ] && return 0

        sync_alert "ABORT push in $name — HEAD is on '$current_branch', not the default branch. Anything pushed from here lands where no one reads it. Either merge to main, open a PR, or re-run with DATACORE_SYNC_ALLOW_BRANCH=1."
        return 1
    }

    if [ "$ACTION" = "pull" ]; then
        echo "Pulling $name..."
        # Fetch all remotes
        git -C "$repo" fetch --all --prune 2>/dev/null
        warn_branch
        # Fork-and-overlay model (DIP-0001): if 'upstream' remote exists,
        # merge upstream first, then push to origin to keep fork in sync.
        if git -C "$repo" remote get-url upstream &>/dev/null; then
            git -C "$repo" merge upstream/main --autostash --no-edit 2>/dev/null \
                && echo "  ✓ merged upstream" \
                || echo "  ⚠️  upstream merge failed (resolve manually)"
            # Push merged upstream changes to fork
            git -C "$repo" push origin main 2>/dev/null || true
        else
            git -C "$repo" pull --rebase --autostash 2>/dev/null || echo "  (no remote or error)"
        fi
    elif [ "$ACTION" = "push" ]; then
        echo "Pushing $name..."
        warn_branch
        abort_if_stray_branch || return 1
        # Stage new and modified files only — NEVER stage deletions automatically.
        # This prevents partial working copies (e.g. nightshift server) from
        # deleting files they don't have locally. Use 'git rm' for intentional deletes.
        git -C "$repo" add --ignore-removal . 2>/dev/null
        # Safety check 1: abort if commit would delete more than 5 files
        local del_count=$(git -C "$repo" diff --cached --diff-filter=D --name-only 2>/dev/null | wc -l | tr -d ' ')
        if [ "$del_count" -gt 5 ]; then
            sync_alert "ABORT push in $name — would delete $del_count files. Review: git -C $repo diff --cached --stat"
            git -C "$repo" reset HEAD 2>/dev/null
            return 1
        fi

        # Safety check 2: abort if any single modified file would lose a huge
        # number of lines. Catches the case where a script truncated a file
        # (e.g. org-workspace data-loss bug, 2026-05-16). Trips when a file
        # loses >500 lines AND those losses are >40% of its HEAD size.
        # Override with DATACORE_SYNC_FORCE=1 for intentional large changes.
        if [ "${DATACORE_SYNC_FORCE:-0}" != "1" ]; then
            local shrink_alert=""
            while IFS=$'\t' read -r added removed path; do
                # Skip binary files (- -) and new files (no HEAD version)
                [ "$added" = "-" ] && continue
                [ -z "$path" ] && continue
                # Only check modifications, not adds/deletes
                local change_type=$(git -C "$repo" diff --cached --name-status -- "$path" 2>/dev/null | awk '{print $1}')
                [ "$change_type" != "M" ] && continue
                # HEAD line count
                local head_lines=$(git -C "$repo" show "HEAD:$path" 2>/dev/null | wc -l | tr -d ' ')
                [ -z "$head_lines" ] || [ "$head_lines" -eq 0 ] && continue
                # Trip if removed > 500 AND removed/head_lines > 40%
                if [ "$removed" -gt 500 ]; then
                    # Integer percent: removed * 100 / head_lines
                    local pct=$((removed * 100 / head_lines))
                    if [ "$pct" -gt 40 ]; then
                        shrink_alert="${shrink_alert}\n  $path: -$removed lines (${pct}% of $head_lines)"
                    fi
                fi
            done < <(git -C "$repo" diff --cached --numstat 2>/dev/null)
            if [ -n "$shrink_alert" ]; then
                sync_alert "ABORT push in $name — suspicious large shrink in modified file(s):$(printf '%b' "$shrink_alert")"
                sync_alert "  Review: git -C $repo diff --cached --stat"
                sync_alert "  If intentional, retry with: DATACORE_SYNC_FORCE=1 ./sync push"
                git -C "$repo" reset HEAD 2>/dev/null
                return 1
            fi
        fi
        # Confidentiality check: if remote is a protected (public) repo, ensure no
        # forbidden paths got staged.
        local remote_url=$(git -C "$repo" remote get-url origin 2>/dev/null || echo "")
        local protected_repo=$(echo "$remote_url" | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
        if [ -n "$protected_repo" ] && [ -f "$HOME/Data/.datacore/config/public-repo-denylist.yaml" ]; then
            local is_protected=$(python3 -c "
import yaml
with open('$HOME/Data/.datacore/config/public-repo-denylist.yaml') as f:
    d = yaml.safe_load(f)
print('1' if '$protected_repo' in d.get('protected_repos', []) else '0')
" 2>/dev/null || echo "0")
            if [ "$is_protected" = "1" ]; then
                local forbidden=$(git -C "$repo" diff --cached --name-only --diff-filter=AM 2>/dev/null | python3 -c "
import sys, yaml, fnmatch
with open('$HOME/Data/.datacore/config/public-repo-denylist.yaml') as f:
    d = yaml.safe_load(f)
patterns = d.get('forbidden_paths', [])
for line in sys.stdin:
    p = line.strip()
    if not p: continue
    for pat in patterns:
        if (fnmatch.fnmatch(p, pat) or
            (pat.startswith('**/') and fnmatch.fnmatch(p, pat[3:])) or
            (pat.endswith('/**') and (p == pat[:-3] or p.startswith(pat[:-3] + '/')))):
            print(f'{p}\t{pat}')
            break
" 2>/dev/null)
                if [ -n "$forbidden" ]; then
                    sync_alert "ABORT push in $name — staged confidential paths for protected repo $protected_repo:"
                    while IFS=$'\t' read -r path pattern; do
                        sync_alert "  $path  (matched: $pattern)"
                    done <<< "$forbidden"
                    sync_alert "Move to private storage or add to .gitignore. Then retry."
                    git -C "$repo" reset HEAD 2>/dev/null
                    return 1
                fi
            fi
        fi
        git -C "$repo" diff --cached --quiet || git -C "$repo" commit -m "Sync: $(date +%Y-%m-%d)"
        git -C "$repo" push 2>/dev/null || echo "  (no remote or error)"
    elif [ "$ACTION" = "status" ]; then
        echo "Status: $name [$current_branch]"
        warn_branch
        git -C "$repo" status --short
    fi
}

# Root repo
sync_repo "." "root"

# All spaces (numbered folders)
for space in [0-9]-*/; do
    if [ -d "$space" ]; then
        sync_repo "$space" "space: $space"
    fi
done

# Modules (independent repos under .datacore/modules/)
for module in .datacore/modules/*/; do
    if [ -d "$module/.git" ]; then
        sync_repo "$module" "module: $(basename $module)"
    fi
done

# DIPs (independent repo)
if [ -d ".datacore/dips/.git" ]; then
    sync_repo ".datacore/dips" "dips"
fi

# All projects within spaces
for space in [0-9]-*/; do
    if [ -d "$space/2-projects" ]; then
        for project in "$space"2-projects/*/; do
            if [ -d "$project/.git" ]; then
                sync_repo "$project" "project: $(basename $project)"
            fi
        done
    fi
done

echo "Sync complete"
