[Unit]
Description=GitHub Triage Fallback — scans GitHub if nightshift missed overnight run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gregor
Group=gregor
# NOTE: On the server, replace %h with absolute path /home/gregor
# The pre-commit hook blocks absolute paths, so this template uses %h
WorkingDirectory=%h/Data
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/config/nightshift.env
ExecStart=/bin/bash %h/Data/.datacore/modules/github/server/triage-github.sh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
