# Fleet names and identities for this installation (gitignored: use fleet.local.yaml)
# This file is NOT tracked. Copy it to fleet.local.yaml and customize for your install.
#
# Every name and path below replaces hardcoded defaults that would otherwise appear in deployed code.
# Leave a section empty {} to use built-in defaults (if any exist).

machines: {}
  # SSH/SCP/RSYNC targets. Used in deploy scripts, remote checks, sync commands.
  # primary: "YOUR_WORKSTATION_HOSTNAME"
  # dayshift: "YOUR_DAY_HOST_HOSTNAME"    # optional: your day host (if different from primary)
  # box: "CLUSTER_HOSTNAME"               # cluster management host
  # pods:                               # keyed by role, never by an agent's name (INS-3)
  #   chief_of_staff: "BOX_POD_NAME@LOCATION"  # Chief of Staff pod identity
  #   research: "RESEARCH_POD_LOCATION"        # Research & memory pod host
  #   operations: "OPS_POD_LOCATION"           # Operations pod host

users: {}
  # Principals and actors in your install. Replaces hardcoded names in code.
  # owner: "YOUR_FIRST_NAME"                       # the owner (appears in escalation)
  # agents:                                       # keyed by role
  #   engineering: "YOUR_NIGHTSHIFT_AGENT_ID"      # nightshift agent principal
  #   research: "YOUR_RESEARCH_AGENT_ID"           # research agent principal
  #   operations: "YOUR_OPS_AGENT_ID"              # operations agent principal

# paths: {}
#   owner_home: "/home/YOUR_NAME"        # owner's home on boxes
#   owner_data: "/home/YOUR_NAME/Data"   # owner's data directory
#   root_data: "/root/Data"              # root-owned data (if applicable)

# spaces: {}
#   personal: "0-YOUR_SPACE_PREFIX"       # your personal space (usually 0-...)
#   all:
#     - "0-personal"
#     - ...list your space IDs here...

# These values are used by:
# - fleet_dashboard.py (VESSELS, POD_DEPLOY, etc)
# - deployment scripts (ssh targets, paths)
# - orchestration (space listings)
# - verification (roster validation)
#
# After creating this file: run `datacore doctor` to verify all names resolve correctly.
# Note: Do not add this file to git (.gitignore blocks it automatically).
