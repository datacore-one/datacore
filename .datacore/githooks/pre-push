#!/usr/bin/env bash
# pre-push: block pushes to protected public repos that contain forbidden
# paths, forbidden content, or disallowed new .datacore/ files.
#
# Layered on top of .gitignore (reactive) and the audit script (post-hoc).
# Policy: .datacore/config/public-repo-denylist.yaml
# Scanner: .datacore/lib/pre_push_scan.py (paths + content + new-file gate;
#          also reads the PRIVATE customer denylist at runtime from
#          ~/.datacore/private/customer-denylist.yaml if present).
#
# Failure modes (2026-07-17 hardening):
#   - Every exit is preceded by a diagnostic (fail LOUD).
#   - Protected repo + missing python3/pyyaml/denylist/scanner = push
#     BLOCKED (fail CLOSED). Non-protected repos are unaffected.
#   - Unknown remote SHA (force-push with stale tracking refs) no longer
#     silently skips the scan — falls back to commits not on any tracking
#     ref of the remote.
#
# Activate globally:  git config --global core.hooksPath "$HOME/Data/.datacore/githooks"
# Bypass (extreme care): SKIP_PRE_PUSH=1 git push ...

set -e
trap 'echo "pre-push: UNEXPECTED ERROR (line $LINENO) — failing CLOSED, push blocked. Debug: bash -x $0" >&2' ERR

REMOTE="$1"
URL="$2"

if [ "${SKIP_PRE_PUSH:-0}" = "1" ]; then
    echo "pre-push: ⚠ BYPASSED via SKIP_PRE_PUSH=1 → push proceeding WITHOUT policy check" >&2
    exit 0
fi

DATA_DIR="${DATA_DIR:-$HOME/Data}"
DENYLIST="$DATA_DIR/.datacore/config/public-repo-denylist.yaml"
SCANNER="$DATA_DIR/.datacore/lib/pre_push_scan.py"
# Fallback protection list, used ONLY when the denylist file is missing.
# These are our public end-user repos; better to block a push here than
# to fail open because a checkout is incomplete.
FALLBACK_PROTECTED="plur-ai/plur datacore-one/datacore datacore-one/datacore-dips datacore-one/datacore-org"

# Capture the ref list once — both the policy check and git-lfs need it.
# core.hooksPath routes ALL repos here, bypassing per-repo .git/hooks/ —
# including the LFS pre-push hook. Without explicit chaining, new LFS
# objects are never uploaded (3-fds silently accumulated 460 objects /
# 824 MB unpushed by 2026-06-10 exactly this way).
REFS_INPUT=$(cat)

OWNERSHIP="$DATA_DIR/.datacore/lib/hooks/log_ownership_guard.py"

# ---- A Python that can actually run the policy ------------------------------
# NOT bare `python3`. This hook runs under whatever launched the push, and cron
# on macOS hands it PATH=/usr/bin:/bin, where python3 is the system 3.9 with no
# PyYAML. The policy chain then could not run, the hook failed CLOSED, and every
# push from a scheduled job on the Mac was blocked: ledger_publish_safe "held"
# 1-datafund and 2-datacore every hour on 2026-09-17 -- while the same push from
# a terminal, where python3 is a pyenv 3.11 with PyYAML, went straight through.
# Failing closed was right; resolving the interpreter by PATH order was the bug.
# Same probe order as runtime_shell.sh, with the one module this hook needs.
HOOK_PY=""
for _c in "${DATACORE_PYTHON:-}" python3.13 python3.12 python3.11 python3.10 \
          /opt/homebrew/bin/python3 /usr/local/bin/python3 \
          "$HOME/.pyenv/shims/python3" python3; do
    [ -n "$_c" ] || continue
    command -v "$_c" >/dev/null 2>&1 || continue
    if "$_c" -c "import yaml" >/dev/null 2>&1; then HOOK_PY="$_c"; break; fi
done

# ---- Single-writer log ownership (DIP-0046 D5, GitHub side) ---------------
# Runs for EVERY repo, before the not-protected early exit further down. Space
# repos are not "protected public repos", so anything placed after that exit
# would never run on the five GitHub-hosted spaces — precisely the ones with no
# server-side pre-receive available.
#
# Reads REFS_INPUT rather than calling `cat` again: stdin can be read ONCE, and
# an earlier revision of this block consumed it here, leaving REFS_INPUT empty
# so LFS chaining and the denylist scan silently scanned nothing.
if [ -f "$OWNERSHIP" ] && [ -n "$HOOK_PY" ] && [ -n "$REFS_INPUT" ]; then
    OWN_RANGES=$(printf '%s\n' "$REFS_INPUT" | while IFS=' ' read -r l_ref l_sha r_ref r_sha; do
        [ -z "$l_ref" ] && continue
        [ "$l_sha" = "0000000000000000000000000000000000000000" ] && continue
        if [ "$r_sha" = "0000000000000000000000000000000000000000" ] || \
           ! git rev-parse --quiet --verify "${r_sha}^{commit}" >/dev/null 2>&1; then
            # r_sha unknown locally (another writer pushed since last fetch).
            # Use merge-base with the remote tracking ref for this branch to scope
            # the check to outgoing commits only. Without this, git rev-list walks
            # the entire history and the author filter catches pre-DIP-0046 commits
            # this machine legitimately wrote, producing false refusals.
            BRANCH="${r_ref#refs/heads/}"
            TRACKING="refs/remotes/${REMOTE}/${BRANCH}"
            OWN_BASE=""
            if git rev-parse --quiet --verify "$TRACKING" >/dev/null 2>&1; then
                OWN_BASE=$(git merge-base "$l_sha" "$TRACKING" 2>/dev/null || true)
            fi
            if [ -z "$OWN_BASE" ]; then
                # A branch origin has never seen (tonight's run branch) has no
                # tracking ref of its own; its outgoing commits are the ones not
                # on the remote's default branch, exactly as the content scan
                # below reasons. Full history was the fallback here, and it
                # refused every new run branch of a repo whose past holds
                # another actor's log edits (6-meridian, 2026-09-05: no run
                # branch could be pushed, so no claim there ever held).
                for candidate in "refs/remotes/${REMOTE}/main" "refs/remotes/${REMOTE}/master" "refs/remotes/${REMOTE}/develop"; do
                    if git rev-parse --quiet --verify "$candidate" >/dev/null 2>&1; then
                        OWN_BASE=$(git merge-base "$l_sha" "$candidate" 2>/dev/null || true)
                        [ -n "$OWN_BASE" ] && break
                    fi
                done
            fi
            if [ -n "$OWN_BASE" ]; then
                echo "pre-push: ownership guard: r_sha ${r_sha:0:12} not local — using merge-base ${OWN_BASE:0:12} (fetch first if this recurs)" >&2
                echo "${OWN_BASE}..${l_sha}"
            else
                echo "pre-push: ownership guard: r_sha ${r_sha:0:12} not local, no tracking ref — range degraded to full history; fetch and retry to avoid false refusals" >&2
                echo "$l_sha"
            fi
        else
            echo "${r_sha}..${l_sha}"
        fi
    done)
    if [ -n "$OWN_RANGES" ]; then
        # shellcheck disable=SC2086
        "$HOOK_PY" "$OWNERSHIP" $OWN_RANGES || exit 1
        "$HOOK_PY" "$DATA_DIR/.datacore/lib/hooks/ledger_write_gate.py" --ranges $OWN_RANGES || exit 1  # LED-3: only EventLog-written ledger lines
    fi
fi

# ---- Local CI gate (opt-in, per repo) --------------------------------------
# A repo opts in by defining a `ci` target in a Makefile at its root. Repos
# without one are untouched, which is every repo but datacore-app today.
#
# Placed here, BEFORE the not-protected early exit further down, for the same
# reason the ownership guard is: most repos in this installation are not
# "protected public repos", so anything after that exit never runs for them.
#
# Why local at all, when a workflow exists: on this machine the local gate is
# the STRONGER of the two. Every private dependency is already present, so it
# runs 1002 tests where the cloud runs 934, and it can run `check-types`, which
# needs the ventures module and pydantic2ts and therefore cannot run on a
# runner. What it cannot do is a clean dependency resolve — that is the weekly
# scheduled workflow's job, and the two are complements, not duplicates.
#
# Bypass: SKIP_LOCAL_CI=1 git push …   (or SKIP_PRE_PUSH=1 to skip everything)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [ "${SKIP_LOCAL_CI:-0}" != "1" ] && [ -n "$REPO_ROOT" ] && [ -n "$REFS_INPUT" ] \
   && [ -f "$REPO_ROOT/Makefile" ] && command -v make >/dev/null 2>&1 \
   && grep -qE '^ci:' "$REPO_ROOT/Makefile"; then
    echo "pre-push: running local CI gate (make ci) — SKIP_LOCAL_CI=1 to bypass" >&2
    # Run from the repo root regardless of the caller's cwd, and give the tests
    # a real terminal-free stdin: stdin here is the ref list, already consumed
    # into REFS_INPUT, and handing a half-read pipe to a test runner hangs it.
    if ! ( cd "$REPO_ROOT" && make ci </dev/null >&2 ); then
        echo "" >&2
        echo "═══════════════════════════════════════════════════════════════" >&2
        echo "PUSH BLOCKED: local CI failed (make ci) in $REPO_ROOT" >&2
        echo "═══════════════════════════════════════════════════════════════" >&2
        echo "Fix the failures above, or bypass deliberately:" >&2
        echo "  SKIP_LOCAL_CI=1 git push ..." >&2
        echo "═══════════════════════════════════════════════════════════════" >&2
        exit 1
    fi
    echo "pre-push: ✓ local CI passed" >&2
fi

# ---- Formal verification gate (any repo with a vendored checker) -----------
# A repo is verified when it tracks a Lean project: a verify.yaml with the
# vendored formal_check.py beside it (dev module, /formal-verify). Runs locally, not
# on GitHub: Lean is installed here, and the proofs are checked before the
# code leaves the machine. --if-touched makes the checker a no-op unless the
# push changes the project or a file a model covers, so ledger and journal
# pushes pay nothing. Hosts without Lean skip with a note rather than block:
# a missing prover is not a failed proof, and must never hold a ledger push.
#
# Checks the working tree against the outgoing range, so push from the branch
# you have checked out. Bypass: SKIP_FORMAL=1 git push …
if [ "${SKIP_FORMAL:-0}" != "1" ] && [ -n "$REPO_ROOT" ] && [ -n "$REFS_INPUT" ] && [ -n "$HOOK_PY" ]; then
    FORMAL_PROJECTS=$(cd "$REPO_ROOT" && git ls-files -- '*verify.yaml' | while read -r v; do
        d=$(dirname "$v"); [ -f "$d/formal_check.py" ] && echo "$d"; done || true)
    if [ -n "$FORMAL_PROJECTS" ]; then
        FORMAL_BASE=$(printf '%s\n' "$REFS_INPUT" | while IFS=' ' read -r l_ref l_sha r_ref r_sha; do
            [ -z "$l_ref" ] && continue
            [ "$l_sha" = "0000000000000000000000000000000000000000" ] && continue
            if [ "$r_sha" != "0000000000000000000000000000000000000000" ] && \
               git rev-parse --quiet --verify "${r_sha}^{commit}" >/dev/null 2>&1; then
                echo "$r_sha"; break
            fi
            for candidate in "refs/remotes/${REMOTE}/${r_ref#refs/heads/}" "refs/remotes/${REMOTE}/main" "refs/remotes/${REMOTE}/master"; do
                if git rev-parse --quiet --verify "$candidate" >/dev/null 2>&1; then
                    git merge-base "$l_sha" "$candidate" 2>/dev/null && break
                fi
            done
            break
        done || true)
        if [ ! -x "$HOME/.elan/bin/lake" ] && ! command -v lake >/dev/null 2>&1; then
            echo "pre-push: formal gate skipped — Lean (lake) not installed on this host" >&2
        else
            for proj in $FORMAL_PROJECTS; do
                if [ -n "$FORMAL_BASE" ]; then
                    set -- --base "$FORMAL_BASE" --if-touched
                else
                    set --   # base unknown: check everything, never assume nothing changed
                fi
                echo "pre-push: formal gate: $proj — SKIP_FORMAL=1 to bypass" >&2
                if ! ( cd "$REPO_ROOT" && "$HOOK_PY" "$proj/formal_check.py" --project "$proj" "$@" </dev/null >&2 ); then
                    echo "" >&2
                    echo "═══════════════════════════════════════════════════════════════" >&2
                    echo "PUSH BLOCKED: formal verification failed in $REPO_ROOT/$proj" >&2
                    echo "═══════════════════════════════════════════════════════════════" >&2
                    echo "Fix the model or the code (see FAIL lines above), or bypass" >&2
                    echo "deliberately:  SKIP_FORMAL=1 git push ..." >&2
                    echo "═══════════════════════════════════════════════════════════════" >&2
                    exit 1
                fi
            done
        fi
    fi
fi

lfs_chain() {
    # DELIBERATELY A NO-OP: this installation does not use git-lfs. Large files
    # are gitignored instead (see each space's .gitignore, e.g. `*.db`).
    #
    # The chain used to run `git lfs pre-push`, which blocked every push to
    # 0-personal with "LFS Server is not enabled" — the Gitea host serves no
    # LFS endpoint, and two vestigial `.lfs-pointer` files in the tree were
    # enough for git-lfs to attempt an upload of blobs nobody has. Four
    # commits sat unpushable behind a feature the installation never adopted.
    #
    # Left as a named function rather than deleted so the intent is visible at
    # the call site: LFS is not merely absent here, it is declined.
    :
}

fail_closed() {
    echo "" >&2
    echo "═══════════════════════════════════════════════════════════════" >&2
    echo "PUSH BLOCKED (fail closed): $REPO is a PROTECTED public repo" >&2
    echo "but the policy chain cannot run:" >&2
    echo "  $1" >&2
    echo "" >&2
    echo "Fix the tooling (do NOT bypass casually):" >&2
    echo "  - python3 + pyyaml:  pip3 install pyyaml" >&2
    echo "  - denylist:          $DENYLIST" >&2
    echo "  - scanner:           $SCANNER" >&2
    echo "Emergency bypass (extreme care): SKIP_PRE_PUSH=1 git push ..." >&2
    echo "═══════════════════════════════════════════════════════════════" >&2
    exit 1
}

# Extract repo identifier (org/name) from remote URL.
REPO=$(echo "$URL" | sed -E 's#^(git@github.com:|https://github.com/|ssh://git@github.com/)##; s#\.git$##')

# ---- Determine whether this remote is protected ---------------------------
PYTHON_OK=1
[ -n "$HOOK_PY" ] || PYTHON_OK=0
if [ "$PYTHON_OK" = "1" ]; then
    "$HOOK_PY" -c "import yaml" >/dev/null 2>&1 || PYTHON_OK=0
fi

IS_PROTECTED=0
if [ -f "$DENYLIST" ]; then
    if [ "$PYTHON_OK" = "1" ]; then
        IS_PROTECTED=$("$HOOK_PY" - "$DENYLIST" "$REPO" <<'PY_POLICY'
import sys, yaml
with open(sys.argv[1]) as f:
    d = yaml.safe_load(f)
if not isinstance(d, dict) or not isinstance(d.get('protected_repos'), list):
    raise ValueError('invalid public repository policy')
print('1' if sys.argv[2] in d['protected_repos'] else '0')
PY_POLICY
        ) || IS_PROTECTED=""
        if [ -z "$IS_PROTECTED" ]; then
            IS_PROTECTED=1
            PYTHON_OK=0
        fi
    else
        # A present policy that cannot be parsed cannot exempt a repository.
        IS_PROTECTED=1
    fi

else
    echo "pre-push: ⚠ denylist NOT FOUND at $DENYLIST — using built-in fallback protected list" >&2
    case " $FALLBACK_PROTECTED " in
        *" $REPO "*) IS_PROTECTED=1 ;;
        *)           IS_PROTECTED=0 ;;
    esac
fi

# A fork of a protected repo is public too, and it is where a user's pushes go:
# `datacore init` forks datacore-one/datacore and keeps it as the `upstream`
# remote. Checking only the push target's name skipped the scan for every fork,
# so it ran for nobody but the operator. Any remote of THIS repo that is a
# protected repo makes the push protected, scanned under the protected policy.
if [ "$IS_PROTECTED" != "1" ]; then
    for _u in $(git remote 2>/dev/null); do
        _slug=$(git remote get-url "$_u" 2>/dev/null | sed -E 's#^(git@github.com:|https://github.com/|ssh://git@github.com/)##; s#\.git$##')
        [ -n "$_slug" ] && [ "$_slug" != "$REPO" ] || continue
        _is=0
        if [ -f "$DENYLIST" ] && [ "$PYTHON_OK" = "1" ]; then
            _is=$("$HOOK_PY" - "$DENYLIST" "$_slug" <<'PY_FORK'
import sys, yaml
d = yaml.safe_load(open(sys.argv[1]))
print('1' if sys.argv[2] in d.get('protected_repos', []) else '0')
PY_FORK
            ) || _is=1
        else
            case " $FALLBACK_PROTECTED " in *" $_slug "*) _is=1 ;; esac
        fi
        if [ "$_is" = "1" ]; then
            echo "pre-push: $REPO is a fork of $_slug — treating as PROTECTED" >&2
            REPO="$_slug"
            IS_PROTECTED=1
            break
        fi
    done
fi

if [ "$IS_PROTECTED" != "1" ]; then
    echo "pre-push: $REPO not a protected public repo — policy check skipped" >&2
    lfs_chain
    exit 0
fi

echo "pre-push: $REPO is PROTECTED — running policy chain…" >&2

# Protected repo: everything must be in place or we fail closed.
[ -f "$DENYLIST" ]  || fail_closed "denylist file missing"
[ "$PYTHON_OK" = "1" ] || fail_closed "python3 with pyyaml not available"
[ -f "$SCANNER" ]   || fail_closed "scanner script missing"

# ---- Collect outgoing commit range per ref --------------------------------
RANGE_TOOL="$DATA_DIR/.datacore/lib/git_privacy.py"
[ -f "$RANGE_TOOL" ] || fail_closed "Git range validator missing"
ALL_RANGE=$(printf '%s\n' "$REFS_INPUT" | "$HOOK_PY" "$RANGE_TOOL" --outgoing "$REMOTE") \
    || fail_closed "cannot establish outgoing commits; fetch the remote and retry"

if [ -z "$ALL_RANGE" ]; then
    echo "pre-push: ✓ no outgoing commits to scan" >&2
    lfs_chain
    exit 0
fi

# ---- Run the scanner (paths + content + new-file gate) --------------------
# (run inside an if-condition so the ERR trap doesn't fire on an expected
# nonzero exit — the scanner's exit code IS the verdict, not an error)
if printf '%s' "$ALL_RANGE" | DATA_DIR="$DATA_DIR" "$HOOK_PY" "$SCANNER" --repo "$REPO" --denylist "$DENYLIST" >&2; then
    SCAN_EXIT=0
else
    SCAN_EXIT=$?
fi

if [ "$SCAN_EXIT" = "2" ]; then
    fail_closed "scanner reported an internal error (exit 2) — see output above"
elif [ "$SCAN_EXIT" != "0" ]; then
    echo "" >&2
    echo "═══════════════════════════════════════════════════════════════" >&2
    echo "PUSH BLOCKED: policy violations for $REPO (see ✗ lines above)" >&2
    echo "═══════════════════════════════════════════════════════════════" >&2
    echo "These paths/contents are confidential and must not reach a" >&2
    echo "public repository. Move them to a private repo or fix the diff." >&2
    echo "" >&2
    echo "False positive? Edit: $DENYLIST" >&2
    echo "Emergency bypass (extreme care): SKIP_PRE_PUSH=1 git push ..." >&2
    echo "═══════════════════════════════════════════════════════════════" >&2
    exit 1
fi

echo "pre-push: ✓ policy chain passed for $REPO" >&2
lfs_chain
exit 0
