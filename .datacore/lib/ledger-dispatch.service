# An actor pulls delegated items from the ledger and executes them.
#
# Install as a user unit. Set DATACORE_ACTOR in the private environment file.
# Each physical writer requires its own actor and ledger identity.
#
# --limit 2 is deliberate. An actor that drains the whole queue in one tick
# starves every other actor of anything to claim, which turns a fleet into a
# single worker. Small bites, every 15 minutes.
#
# --actor MUST be this machine's roster name from registry/infrastructure.yaml.
# Two machines sharing an actor name would write to the same per-writer log and
# break the one-file-per-writer invariant the whole design rests on.

[Unit]
Description=Pull delegated items from the ledger and execute them
Documentation=file:.datacore/lib/ledger_claim.py

[Service]
Type=oneshot
WorkingDirectory=%h/Data
EnvironmentFile=%h/.config/datacore/dispatcher.env
ExecStart=/usr/bin/python3 %h/Data/.datacore/lib/ledger_claim.py --space %h/Data/2-datacore --limit 2 --execute
