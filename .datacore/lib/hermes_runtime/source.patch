+"""Preserve tool state at compaction without assigning it user authority."""
+import uuid
+
+
+_CALL_PREFIX = 'call_dc_todo_snapshot_'
+
+
+def _snapshot_pair(call, result):
+    if not isinstance(call, dict) or not isinstance(result, dict):
+        return False
+    calls = call.get('tool_calls')
+    if (call.get('role') != 'assistant' or call.get('content') not in (None, '')
+            or not isinstance(calls, list) or len(calls) != 1
+            or not isinstance(calls[0], dict)):
+        return False
+    item = calls[0]
+    identifier = item.get('id')
+    return (isinstance(identifier, str) and identifier.startswith(_CALL_PREFIX)
+            and item.get('type') == 'function'
+            and item.get('function') == {'name': 'todo', 'arguments': '{}'}
+            and result.get('role') == 'tool'
+            and result.get('tool_call_id') == identifier
+            and result.get('tool_name', result.get('name')) == 'todo')
+
+
+def refresh_todo_snapshot(messages, store):
+    """Replace only our complete tool snapshot pairs; preserve human bytes.
+
+    IDs, tool names and read-only arguments survive SessionDB serialization.
+    Text markers and temporary underscore flags are not evidence for deleting
+    any part of a human message. Earlier source rows remain in the session's
+    compaction archive; this updates the active context's current tool state.
+    """
+    retained = []
+    index = 0
+    while index < len(messages):
+        if index + 1 < len(messages) and _snapshot_pair(messages[index], messages[index + 1]):
+            index += 2
+        else:
+            retained.append(messages[index])
+            index += 1
+    snapshot = store.snapshot_for_injection()
+    if snapshot:
+        from agent.tool_dispatch_helpers import make_tool_result_message
+
+        identifier = _CALL_PREFIX + uuid.uuid4().hex
+        retained.extend([
+            {'role': 'assistant', 'content': None, 'tool_calls': [
+                {'id': identifier, 'type': 'function',
+                 'function': {'name': 'todo', 'arguments': '{}'}}]},
+            make_tool_result_message('todo', snapshot, identifier),
+        ])
+    return retained
