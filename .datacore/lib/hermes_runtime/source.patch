+    def test_cron_repairs_do_not_overwrite_a_concurrent_create(self):
+        import tempfile
+        from concurrent.futures import ThreadPoolExecutor
+        from threading import Event, current_thread
+        from cron import jobs
+        with tempfile.TemporaryDirectory() as directory, jobs.use_cron_store(directory):
+            original=jobs.create_job(prompt='Synthetic preserved job',schedule='every 30m')
+            path=Path(directory)/'cron/jobs.json'
+            path.write_text(json.dumps([original]))  # supported legacy bare-list representation
+            read=Event(); writer_done=Event()
+            real_load=json.load
+            def pause_reader(handle,*args,**kwargs):
+                value=real_load(handle,*args,**kwargs)
+                if current_thread().name.startswith('repair-reader'):
+                    read.set(); writer_done.wait(0.25)
+                return value
+            def reader():
+                with jobs.use_cron_store(directory): return jobs.load_jobs()
+            def writer():
+                self.assertTrue(read.wait(5))
+                try:
+                    with jobs.use_cron_store(directory):
+                        return jobs.create_job(prompt='Synthetic concurrent job',schedule='every 30m')
+                finally: writer_done.set()
+            with patch.object(jobs.json,'load',side_effect=pause_reader):
+                with ThreadPoolExecutor(max_workers=1,thread_name_prefix='repair-reader') as readers, ThreadPoolExecutor(max_workers=1) as writers:
+                    one=readers.submit(reader); two=writers.submit(writer)
+                    one.result(timeout=10); created=two.result(timeout=10)
+            self.assertEqual({job['id'] for job in jobs.load_jobs()},{original['id'],created['id']})
