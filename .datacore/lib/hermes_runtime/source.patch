+"""Exercise real installed HTTP adapters using synthetic loopback traffic only."""
+import asyncio
+import hashlib
+import hmac
+import json
+from pathlib import Path
+import secrets
+import time
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import aiohttp
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+from gateway.platforms.webhook import WebhookAdapter
+
+
+class HTTPAdapters(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.key=secrets.token_hex(32)
+        self.client=aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10))
+        self.adapters=[]
+
+    async def asyncTearDown(self):
+        await self.client.close()
+        for adapter in reversed(self.adapters): await adapter.disconnect()
+
+    async def api(self, key=None):
+        adapter=APIServerAdapter(PlatformConfig(enabled=True,extra={'host':'127.0.0.1','port':0,'key':self.key if key is None else key}))
+        self.adapters.append(adapter)
+        return adapter
+
+    async def webhook(self, secret=None, host='127.0.0.1'):
+        adapter=WebhookAdapter(PlatformConfig(enabled=True,extra={
+            'host':host,'port':0,'secret':self.key if secret is None else secret,
+            'routes':{'audit':{'events':['synthetic.accepted'],'prompt':'Synthetic audit input','deliver':'log'}},
+            'max_body_bytes':65536}))
+        self.adapters.append(adapter)
+        return adapter
+
+    def url(self, adapter):
+        sockets=[s for site in adapter._runner.sites for s in site._server.sockets]
+        self.assertEqual(len(sockets),1)
+        host,port=sockets[0].getsockname()[:2]
+        self.assertEqual(host,'127.0.0.1')
+        return f'http://127.0.0.1:{port}'
+
+    def signature(self, body, timestamp=None):
+        ts=str(int(time.time()) if timestamp is None else timestamp)
+        signed=ts.encode()+b'.'+body
+        return {'X-Webhook-Timestamp':ts,'X-Webhook-Signature-V2':hmac.new(self.key.encode(),signed,hashlib.sha256).hexdigest()}
+
+    async def test_api_refuses_missing_or_weak_key_before_listening(self):
+        for key in ('','short','your_api_key_here'):
+            with self.subTest(key_class=len(key)):
+                adapter=await self.api(key)
+                self.assertFalse(await adapter.connect())
+                self.assertIsNone(adapter._runner)
+
+    async def test_api_protected_reads_require_bearer_auth(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        base=self.url(adapter)
+        for path in ('/v1/models','/health/detailed','/api/sessions','/v1/capabilities'):
+            for auth in ('','Bearer wrong-token','Bearer wrong-\u00e9-token'):
+                with self.subTest(path=path,auth_present=bool(auth)):
+                    async with self.client.get(base+path,headers={'Authorization':auth}) as response:
+                        self.assertEqual(response.status,401)
+        async with self.client.get(base+'/v1/models',headers={'Authorization':'Bearer '+self.key}) as response:
+            self.assertEqual(response.status,200)
+            self.assertEqual((await response.json())['object'],'list')
+        async with self.client.get(base+'/health') as response: self.assertEqual(response.status,200)
+
+    async def test_api_idempotency_does_not_cross_independent_adapters(self):
+        first=await self.api(); second=await self.api(secrets.token_hex(32))
+        for adapter,label in ((first,'synthetic-alpha'),(second,'synthetic-beta')):
+            adapter._run_agent=AsyncMock(return_value=({'final_response':label,'completed':True},{}))
+            self.assertTrue(await adapter.connect())
+        body={'model':'synthetic','messages':[{'role':'user','content':'Synthetic input'}]}
+        for adapter,label in ((first,'synthetic-alpha'),(second,'synthetic-beta')):
+            headers={'Authorization':'Bearer '+adapter._api_key,'Idempotency-Key':self.key}
+            async with self.client.post(self.url(adapter)+'/v1/chat/completions',json=body,headers=headers) as response:
+                self.assertEqual(response.status,200)
+                self.assertEqual((await response.json())['choices'][0]['message']['content'],label)
+        self.assertEqual(first._run_agent.await_count,1)
+        self.assertEqual(second._run_agent.await_count,1)
+
+    async def test_api_failed_completion_remains_retryable(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        adapter._run_agent=AsyncMock(side_effect=[({'failed':True,'completed':False,'error':'synthetic outage','final_response':''},{}),({'completed':True,'final_response':'synthetic recovered'}, {})])
+        body={'model':'synthetic','messages':[{'role':'user','content':'Synthetic retry input'}]}
+        headers={'Authorization':'Bearer '+self.key,'Idempotency-Key':self.key}
+        url=self.url(adapter)+'/v1/chat/completions'
+        async with self.client.post(url,json=body,headers=headers) as response: self.assertGreaterEqual(response.status,500)
+        async with self.client.post(url,json=body,headers=headers) as response:
+            self.assertEqual(response.status,200)
+            self.assertEqual((await response.json())['choices'][0]['message']['content'],'synthetic recovered')
+        self.assertEqual(adapter._run_agent.await_count,2)
+
+    async def test_api_idempotency_keeps_memory_session_scopes_distinct(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        async def execute(**kwargs): return ({'completed':True,'final_response':kwargs['gateway_session_key']},{})
+        adapter._run_agent=AsyncMock(side_effect=execute)
+        body={'model':'synthetic','messages':[{'role':'user','content':'Synthetic scoped input'}]}
+        for scope in ('synthetic-alpha','synthetic-beta'):
+            headers={'Authorization':'Bearer '+self.key,'Idempotency-Key':self.key,'X-Hermes-Session-Key':scope}
+            async with self.client.post(self.url(adapter)+'/v1/chat/completions',json=body,headers=headers) as response:
+                self.assertEqual(response.status,200)
+                self.assertEqual((await response.json())['choices'][0]['message']['content'],scope)
+        self.assertEqual(adapter._run_agent.await_count,2)
+
+    async def test_api_rejects_non_object_bodies_before_processing(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        adapter._run_agent=AsyncMock(side_effect=AssertionError('must not execute malformed input'))
+        for path in ('/v1/chat/completions','/v1/responses','/v1/runs','/api/jobs'):
+            for body in ([],None,1,'text',True):
+                with self.subTest(path=path,shape=type(body).__name__):
+                    async with self.client.post(self.url(adapter)+path,data=json.dumps(body),headers={'Authorization':'Bearer '+self.key,'Content-Type':'application/json'}) as response:
+                        self.assertEqual(response.status,400)
+        self.assertEqual(adapter._run_agent.await_count,0)
+
+    async def test_api_rejects_invalid_message_shapes_before_processing(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        adapter._run_agent=AsyncMock(side_effect=AssertionError('must not execute malformed input'))
+        for message in (None,1,'text',[],{'role':[],'content':'synthetic'}):
+            with self.subTest(shape=type(message).__name__):
+                async with self.client.post(self.url(adapter)+'/v1/chat/completions',json={'messages':[message]},headers={'Authorization':'Bearer '+self.key}) as response:
+                    self.assertEqual(response.status,400)
+        self.assertEqual(adapter._run_agent.await_count,0)
+
+    async def test_api_responses_retry_reuses_response_and_persistence(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        adapter._run_agent=AsyncMock(return_value=({'completed':True,'final_response':'Synthetic stable response'},{}))
+        body={'input':'Synthetic stable request','store':True}
+        headers={'Authorization':'Bearer '+self.key,'Idempotency-Key':self.key}
+        records=[]
+        with patch.object(adapter._response_store,'put',wraps=adapter._response_store.put) as put:
+            for _ in range(2):
+                async with self.client.post(self.url(adapter)+'/v1/responses',json=body,headers=headers) as response:
+                    self.assertEqual(response.status,200)
+                    records.append(await response.json())
+            self.assertEqual(put.call_count,1)
+        self.assertEqual(records[0],records[1])
+        self.assertEqual(adapter._run_agent.await_count,1)
+
+    async def test_api_concurrent_identical_requests_share_one_success(self):
+        adapter=await self.api(); self.assertTrue(await adapter.connect())
+        entered=asyncio.Event(); release=asyncio.Event()
+        async def execute(**kwargs):
+            entered.set(); await release.wait()
+            return ({'completed':True,'final_response':'Synthetic concurrent result'}, {})
+        adapter._run_agent=AsyncMock(side_effect=execute)
+        body={'input':'Synthetic concurrent request','store':True}
+        headers={'Authorization':'Bearer '+self.key,'Idempotency-Key':self.key}
+        async def request():
+            async with self.client.post(self.url(adapter)+'/v1/responses',json=body,headers=headers) as response:
+                self.assertEqual(response.status,200)
+                return await response.json()
+        first=asyncio.create_task(request())
+        await asyncio.wait_for(entered.wait(),5)
+        second=asyncio.create_task(request())
+        await asyncio.sleep(0.05)
