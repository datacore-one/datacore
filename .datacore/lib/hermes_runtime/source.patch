+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory); source=root/'source'; target=root/'target'
+            source.write_bytes(b'new complete value'); target.write_bytes(b'old complete value')
+            events=[]; sync=os.fsync; replace=os.replace
