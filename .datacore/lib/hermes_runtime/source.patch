+def json_payload_within_depth(value: Any, max_depth: int = 64) -> bool:
+    """Bound container nesting without recursive processing or string scans."""
+    pending = [(value, 0)]
+    while pending:
+        item, depth = pending.pop()
+        if isinstance(item, (dict, list)):
+            depth += 1
+            if depth > max_depth:
+                return False
+            children = item.values() if isinstance(item, dict) else item
+            pending.extend((child, depth) for child in children)
+    return True
+
