+        before = db.get_messages_as_conversation('parent', repair_alternation=True)
+        with pytest.raises(ValueError):
+            agent._hydrate_todo_store(copy.deepcopy(before))
+        assert agent._todo_store.read() == []
+        assert db.get_messages_as_conversation('parent', repair_alternation=True) == before
+    finally:
+        db.close()
