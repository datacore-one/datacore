#!/bin/sh
# fleet-backup -- nightly copy of every agent's volume, run as root on the node.
#
#   fleet-backup                      back up every agent volume in $NS
#   fleet-backup restore AGENT FILE   put a backup back into AGENT's volume
#
# The agent is stopped for the copy so its SQLite databases and git working
# copies are consistent, then started again with the replica count it had. An
# agent already stopped (kill switch, or off) is copied without being started.
# Backups land in $DEST/<agent>/<UTC time>.tar.gz with a .sha256 beside them;
# the newest $KEEP are kept. The signing key is NOT in the volume: it is a
# Secret, backed up separately as $DEST/<agent>/signing-key.secret.yaml (root only).
set -eu
NS=${NS:-firm}
DEST=${DEST:-/var/backups/fleet}
KEEP=${KEEP:-7}
export KUBECONFIG=${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}
K="kubectl -n $NS"

log() { echo "fleet-backup: $*"; }

volume_path() {  # volume_path AGENT -> host directory of AGENT-home
    pv=$($K get pvc "$1-home" -o jsonpath='{.spec.volumeName}')
    p=$(kubectl get pv "$pv" -o jsonpath='{.spec.local.path}{.spec.hostPath.path}')
    [ -n "$p" ] && [ -d "$p" ] || { log "no host directory for $1-home"; exit 1; }
    echo "$p"
}

stop_agent() {  # prints the replica count it had
    r=$($K get deploy "$1" -o jsonpath='{.spec.replicas}')
    if [ "${r:-0}" -gt 0 ]; then
        $K scale "deploy/$1" --replicas=0 >/dev/null
        $K wait --for=delete pod -l "app.kubernetes.io/name=$1" --timeout=180s >/dev/null 2>&1 || true
    fi
    echo "${r:-0}"
}

start_agent() {  # start_agent AGENT REPLICAS
    [ "$2" -gt 0 ] && $K scale "deploy/$1" --replicas="$2" >/dev/null
    return 0
}

backup_one() {
    a=$1
    path=$(volume_path "$a")
    mkdir -p "$DEST/$a"; chmod 700 "$DEST" "$DEST/$a"
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    out="$DEST/$a/$ts.tar.gz"
    was=$(stop_agent "$a")
    trap 'start_agent "$a" "$was"' EXIT
    tar -C "$path" -czpf "$out.part" .
    start_agent "$a" "$was"; trap - EXIT
    mv "$out.part" "$out"
    (cd "$DEST/$a" && sha256sum "$ts.tar.gz" > "$ts.tar.gz.sha256")
    $K get secret "$a-signing-key" -o yaml > "$DEST/$a/signing-key.secret.yaml"
    chmod 600 "$out" "$DEST/$a/signing-key.secret.yaml"
    ls -1t "$DEST/$a"/*.tar.gz | tail -n +$((KEEP + 1)) | while read -r old; do rm -f "$old" "$old.sha256"; done
    log "$a: $out ($(du -h "$out" | cut -f1)), agent back to $was replica(s)"
}

restore_one() {
    a=$1; file=$2
    [ -f "$file" ] || { log "no such backup: $file"; exit 1; }
    (cd "$(dirname "$file")" && sha256sum -c "$(basename "$file").sha256" >/dev/null) \
        || { log "checksum mismatch: $file"; exit 1; }
    path=$(volume_path "$a")
    was=$(stop_agent "$a")
    aside="$path.pre-restore-$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir "$aside"
    find "$path" -mindepth 1 -maxdepth 1 -exec mv {} "$aside"/ \;
    tar -C "$path" -xzpf "$file"
    start_agent "$a" "$was"
    log "$a restored from $file; previous content kept in $aside"
}

case "${1:-}" in
    restore) restore_one "$2" "$3" ;;
    "")
        for pvc in $($K get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | grep -- '-home$'); do
            backup_one "${pvc%-home}"
        done ;;
    *) sed -n '2,12p' "$0"; exit 2 ;;
esac
