#!/usr/bin/env bash
# agent-new -- set up an agent fresh from its runtime template; only its
# identity is carried over (from an old host, or from local files).
#
#   agent-new preflight   cluster ready, deployment at 0, empty volume; old host reachable if any
#   agent-new freeze      old host only: stop and DISABLE the agent's units, cron lines, processes
#   agent-new key         signing key -> Secret (moved, never generated), fingerprints compared
#   agent-new identity    copy exactly the IDENTITY paths into the volume, checksums compared
#   agent-new clone       clone the CLONES checkouts as the agent, through the proxy
#   agent-new setup       run SETUP in the agent's volume (runtime config, plugin registration)
#   agent-new mark        write the start marker: the agent runs nowhere else now
#   agent-new start       helm upgrade with the agent running, wait until ready
#   agent-new rollback    scale to 0, remove the marker, re-enable the old host
#
# The agent's entry (runtime, signingKeySecret, crontab, ...) must already be in
# VALUES with running: false, and installed, so its volume exists.
#
# Settings come from the file named by NEW_ENV: AGENT, VALUES, IMAGE,
# AGENT_HOME (default /var/lib/agent), NS, RELEASE; IDENTITY (paths relative to
# the source home, space separated); CLONES (one "path url [branch]" per line,
# path relative to AGENT_HOME); SETUP (shell run in the volume as the agent);
# NEVER_COPY (paths that must never arrive). With an old host: OLD_HOST,
# OLD_HOME, SSH_OPTS, USER_UNITS, SYSTEM_UNITS ("-" for none), PROCESS_PATTERN.
# Without one: IDENTITY_DIR (a local directory laid out like a home) and
# KEY_FILE.
set -euo pipefail

[ -n "${NEW_ENV:-}" ] && [ -f "$NEW_ENV" ] || { echo "agent-new: set NEW_ENV to the agent's settings file" >&2; exit 2; }
# shellcheck disable=SC1090
. "$NEW_ENV"
AGENT_HOME=${AGENT_HOME:-/var/lib/agent}
# shellcheck source=agent-common.sh
. "$(dirname "$0")/agent-common.sh"
need AGENT VALUES IMAGE
IDENTITY=${IDENTITY:-}
CLONES=${CLONES:-}
SETUP=${SETUP:-}
NEVER_COPY=${NEVER_COPY:-}

source_tar() {  # tar of the IDENTITY paths on stdout, from the old host or IDENTITY_DIR
  if [ -n "${OLD_HOST:-}" ]; then
    old "cd $OLD_HOME && tar -cpf - $IDENTITY"
  else
    need IDENTITY_DIR
    tar -C "$IDENTITY_DIR" -cpf - $IDENTITY
  fi
}

source_sum() {  # checksum manifest of the IDENTITY paths at the source
  m="find $IDENTITY -type f -print0 2>/dev/null | sort -z | xargs -0 sha256sum | sha256sum"
  if [ -n "${OLD_HOST:-}" ]; then old "cd $OLD_HOME && $m"; else (cd "$IDENTITY_DIR" && sh -c "$m"); fi
}

preflight() {
  cluster_ready
  helper_up
  present=$(in_vol sh -c "ls -A $AGENT_HOME | grep -vxE 'lost\+found|\.datacore' || true")
  [ -z "$present" ] || die "volume $AGENT-home is not empty (found: $(echo $present | head -c 200)); use agent-cutover or agent-restore"
  [ -z "${OLD_HOST:-}" ] || old_ready
  say "preflight ok"
}

freeze() {
  [ -n "${OLD_HOST:-}" ] || { say "no old host: nothing to freeze"; return; }
  freeze_old
}

key() { key_secret; }

identity() {
  need IDENTITY
  helper_up
  for f in $NEVER_COPY; do
    case " $IDENTITY " in *" $f "*) die "$f is in IDENTITY but must never be copied";; esac
  done
  source_tar | in_vol tar -C "$AGENT_HOME" --no-overwrite-dir -xpf -
  a=$(source_sum); b=$(in_vol sh -c "cd $AGENT_HOME && find $IDENTITY -type f -print0 2>/dev/null | sort -z | xargs -0 sha256sum | sha256sum")
  [ "$a" = "$b" ] || die "identity checksums differ: $a vs $b"
  for f in $NEVER_COPY; do in_vol test ! -e "$AGENT_HOME/$f" || die "$f arrived although it must never be copied"; done
  say "identity copied, checksums identical: $IDENTITY"
}

clone() {
  helper_up
  [ -n "$CLONES" ] || { say "no CLONES"; return; }
  # ssh, too, leaves through the proxy: the pod has no other way out.
  in_vol sh -c "mkdir -p $AGENT_HOME/.ssh && chmod 700 $AGENT_HOME/.ssh && touch $AGENT_HOME/.ssh/config && grep -q egress.shared.svc $AGENT_HOME/.ssh/config || { printf 'Host *\n  ProxyCommand nc -X connect -x egress.shared.svc.cluster.local:3128 %%h %%p\n\n' | cat - $AGENT_HOME/.ssh/config > $AGENT_HOME/.ssh/config.new && mv $AGENT_HOME/.ssh/config.new $AGENT_HOME/.ssh/config; }"
  printf '%s\n' "$CLONES" | while read -r path url branch; do
    [ -n "${path:-}" ] || continue
    case "$path" in \#*) continue;; esac
    if in_vol test -d "$AGENT_HOME/$path/.git"; then say "$path already cloned"; continue; fi
    in_vol git clone -q ${branch:+--branch "$branch"} "$url" "$AGENT_HOME/$path" </dev/null \
      || die "clone of $path failed"
    say "cloned $path at $(in_vol git -C "$AGENT_HOME/$path" rev-parse --short HEAD </dev/null)"
  done
}

setup() {
  helper_up
  [ -n "$SETUP" ] || { say "no SETUP"; return; }
  in_vol sh -c "cd $AGENT_HOME && $SETUP"
  say "setup done"
}

mark() {
  if [ -n "${OLD_HOST:-}" ]; then
    left=$(old "pgrep -u \$(id -u) -af '$PROCESS_PATTERN' | grep -v pgrep || true")
    [ -z "$left" ] || die "agent processes still running on $OLD_HOST: $left (run freeze)"
    mark_runs_nowhere_else "$OLD_HOST frozen"
  else
    mark_runs_nowhere_else "new agent, never ran elsewhere"
  fi
}

start() { start_agent; }

rollback() {
  stop_agent
  helper_up
  in_vol rm -f "$AGENT_HOME/.datacore/state/k3s-cutover-frozen"
  helper_down
  [ -z "${OLD_HOST:-}" ] || { say "if the pod wrote ledger events, push them from the volume BEFORE the old host runs again"; thaw_old; }
}

case "${1:-}" in
  preflight|freeze|key|identity|clone|setup|mark|start|rollback) "$1" ;;
  *) sed -n '2,29p' "$0"; exit 2 ;;
esac
