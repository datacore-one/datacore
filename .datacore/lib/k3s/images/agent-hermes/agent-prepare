#!/bin/sh
# agent-prepare -- runs before the agent's containers start.
#
# 1. Single-writer guard: the cutover writes FROZEN only after it has stopped
#    and disabled the agent on its old host and confirmed no process is left.
#    Without it the pod refuses to start, so a half-done cutover can never run
#    one agent in two places.
# 2. Points the volume's runtime paths at the code in this image.
set -eu
FROZEN="$HOME/.datacore/state/k3s-cutover-frozen"
if [ ! -s "$FROZEN" ]; then
    echo "agent-prepare: refusing to start: $FROZEN is missing." >&2
    echo "agent-prepare: the old host has not been recorded as frozen by the cutover." >&2
    exit 1
fi
echo "agent-prepare: old host frozen: $(head -1 "$FROZEN")"

link() {  # link <path-in-volume> <target-in-image>
    if [ -L "$1" ]; then
        ln -sfn "$2" "$1"
    elif [ -e "$1" ]; then
        echo "agent-prepare: $1 is a real directory, moved to $1.pre-k3s" >&2
        mv "$1" "$1.pre-k3s"
        ln -s "$2" "$1"
    else
        mkdir -p "$(dirname "$1")"
        ln -s "$2" "$1"
    fi
}
link "$HOME/.hermes/hermes-agent" /opt/hermes-agent
link "$HOME/.hermes/node" /opt/node
echo "agent-prepare: runtime linked into the image"
