# Datacore Environment Configuration
# Copy to .env and fill in your values
# This file is loaded by MCP servers and various Datacore tools

# === AI Services ===

# Perplexity AI (web search via MCP)
PERPLEXITY_API_KEY=your-perplexity-api-key

# Exa (web search via MCP)
EXA_API_KEY=your-exa-api-key

# Jina (web reading via MCP)
JINA_API_KEY=your-jina-api-key

# Google Gemini (research via MCP)
GOOGLE_API_KEY=your-google-api-key

# Gamma (presentation generation via MCP)
# Note: configured in .mcp.json directly
# GAMMA_API_KEY=your-gamma-api-key

# === Optional Services ===

# Anthropic (if using API directly)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# NotebookLM (podcast generation)
# NLM_COOKIE=your-notebooklm-cookie

# PostHog (analytics for landing pages)
# POSTHOG_API_KEY=your-posthog-api-key

# === Nightshift Server ===
# NIGHTSHIFT_HOST=user@your-server-ip

# === Datacore Root (override default ~/Data) ===
# DATACORE_ROOT=~/Data
