version: "1.0"
updated: "YYYY-MM-DD"

# Credential Index — Searchable registry of all credentials
# Per DIP-0018 Credential Management
#
# Setup:
#   1. Copy this file to credential-index.yaml
#   2. Replace examples with your actual credentials
#   3. Run: python .datacore/lib/creds.py audit
#
# CLI Usage:
#   python .datacore/lib/creds.py list                     # List all
#   python .datacore/lib/creds.py list --tier critical      # Filter by tier
#   python .datacore/lib/creds.py show <id>                 # Show details
#   python .datacore/lib/creds.py search "anthropic"        # Search all fields
#   python .datacore/lib/creds.py audit                     # Run audit checks

credentials:
  # Example 1: AI service API key (medium tier, shared across projects)
  - id: anthropic-api-key
    name: "Anthropic API Key"
    type: api_key
    security_tier: high
    category: ai-services
    provider: anthropic
    locations:
      - path: ".datacore/env/.env"
        var_name: "ANTHROPIC_API_KEY"
        primary: true
    used_by:
      - "0-personal"
    description: "Claude API access for agents and automation"
    documentation: "https://docs.anthropic.com/"

  # Example 2: Database credential (critical tier, secrets-repo storage)
  - id: prod-database-url
    name: "Production Database"
    type: connection_string
    security_tier: critical
    category: database
    provider: postgres
    locations:
      - path: "secrets-repo://project-envs/prod.env"
        var_name: "DATABASE_URL"
        primary: true
    used_by:
      - "1-teamspace/2-projects/webapp"
    description: "Production PostgreSQL connection string"
    note: "Rotate quarterly"

  # Example 3: Analytics key (low tier, project-specific)
  - id: posthog-project-key
    name: "PostHog Project Key"
    type: api_key
    security_tier: low
    category: analytics
    provider: posthog
    locations:
      - path: ".datacore/env/analytics.env"
        var_name: "POSTHOG_API_KEY"
        primary: true
      - path: "1-teamspace/2-projects/webapp/.env"
        var_name: "NEXT_PUBLIC_POSTHOG_KEY"
        primary: false
        note: "Legacy location, migrate to shared"
    used_by:
      - "1-teamspace/2-projects/webapp"
    description: "Product analytics and feature flags"
    documentation: "https://posthog.com/docs"

# Security Tiers (descending order of sensitivity)
security_tiers:
  critical:
    description: "Private keys, database credentials, SSH keys"
    storage: "secrets-repo only, never in project .env"
    rotation: "quarterly or on suspicion of compromise"

  high:
    description: "API keys with billing or destructive capabilities"
    storage: "secrets-repo preferred, .datacore/env/ acceptable"
    rotation: "semi-annually"

  medium:
    description: "Read-only API keys, development endpoints"
    storage: ".datacore/env/ preferred, project .env acceptable"
    rotation: "annually"

  low:
    description: "Public webhooks, non-sensitive config"
    storage: "any location"
    rotation: "as needed"

# Categories (for organization and filtering)
categories:
  blockchain: "Private keys, wallets, signing credentials"
  blockchain-rpc: "Blockchain node RPC endpoints"
  decentralized-storage: "Storage network stamps, overlays"
  ai-services: "LLM and AI platform API keys"
  analytics: "Product analytics and observability"
  deployment: "CI/CD, hosting, infrastructure"
  development: "GitHub, NPM, dev tools"
  database: "Database connection strings"
  storage: "Object storage, file systems"
  communication: "Email, Slack, webhooks"
  machine-specific: "SSH keys, machine-tied credentials"
