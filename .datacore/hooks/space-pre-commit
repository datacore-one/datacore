#!/bin/sh
# Space-repo pre-commit hook — structural + safety checks.
#
# Installed into each [0-9]-*/.git/hooks/pre-commit by
# .datacore/lib/install_space_hooks.py (idempotent; re-run weekly by
# nightshift Phase 9.5 so the server's space repos get it too).
#
# Combines:
#   A. DIP-0015 root allowlist (was previously deployed to only 2 of 9
#      spaces) — blocks NEW files/dirs at space root. Spaces with legacy
#      top-level dirs grandfather them via .datacore/structure-allow
#      (one name per line); migrating those stays a structural-integrity
#      task, but new drift is stopped at commit time.
#   B. Safety checks: committed git conflict markers (corrupted org
#      files more than once), DIP-0002 private layer files, obvious
#      credential patterns.
#
# Emergency bypass: git commit --no-verify

ALLOWED_DIRS="org journal today 0-inbox 1-tracks 2-projects 3-knowledge 4-outbox 4-archive notes .datacore .claude .git .github"
ALLOWED_FILES=".gitignore .gitattributes .gitmodules _index.md README.md CLAUDE.md CLAUDE.base.md CLAUDE.space.md CLAUDE.org.md CLAUDE.team.md CLAUDE.local.md SCAFFOLDING.md SCAFFOLDING.base.md SCAFFOLDING.space.md SCAFFOLDING.local.md venture.yaml hypotheses.yaml roadmap.yaml mail.yaml goals.yaml VISION.md CEO_BOOTSTRAP.md dashboard.md strategy.yaml .DS_Store"

# Per-space grandfathered entries (legacy dirs/files, one per line)
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
extra_allow=""
if [ -n "$repo_root" ] && [ -f "$repo_root/.datacore/structure-allow" ]; then
  extra_allow=$(grep -v '^#' "$repo_root/.datacore/structure-allow" 2>/dev/null)
fi

# quotePath=false: git quotes a path with a non-ASCII byte ("3-knowledge/…/José-Andrés.md")
# and the leading quote then reads as an unknown root directory. Four CRM
# people files refused every autosave on winston's 1-datafund on 2026-09-05,
# and with it the whole fleet sync of that space.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$staged" ] && exit 0

vfile=$(mktemp)
sfile=$(mktemp)
trap 'rm -f "$vfile" "$sfile"' EXIT

_allowed() {
  # $1 = name, $2 = list
  echo "$2" | tr ' ' '\n' | grep -qx "$1" && return 0
  [ -n "$extra_allow" ] && echo "$extra_allow" | grep -qx "$1" && return 0
  return 1
}

# --- A. DIP-0015 root allowlist ----------------------------------------------
# SAFETY_ONLY=1 (set by the central githooks dispatcher for non-space
# repos like app/module/project repos) skips the space-structure check.
[ "${SAFETY_ONLY:-0}" = "1" ] || echo "$staged" | while IFS= read -r file; do
  [ -z "$file" ] && continue
  top=$(echo "$file" | cut -d'/' -f1)
  if ! echo "$file" | grep -q '/'; then
    _allowed "$top" "$ALLOWED_FILES" && continue
    printf "  %s (unexpected root file)\n" "$file" >> "$vfile"
    continue
  fi
  _allowed "$top" "$ALLOWED_DIRS" && continue
  printf "  %s (unexpected root directory: %s/)\n" "$file" "$top" >> "$vfile"
done

# --- B. Safety checks ----------------------------------------------------------
cred_pattern='(AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-ant-[A-Za-z0-9-]{20,}|xox[bap]-[0-9A-Za-z-]{10,})'
echo "$staged" | while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ -f "$file" ] || continue
  case "$file" in
    *.local.md)
      printf "  %s (PRIVATE layer *.local.md, DIP-0002 — never committed)\n" "$file" >> "$sfile"
      continue ;;
  esac
  blob=$(git show ":$file" 2>/dev/null) || continue
  if echo "$blob" | grep -qE '^(<{7}( |$)|={7}$|>{7}( |$))'; then
    printf "  %s (git conflict markers — committed markers corrupt org parsing)\n" "$file" >> "$sfile"
  fi
  # Test fixtures legitimately carry fake credential-shaped strings (e.g. a
  # sk-ant-oat01-TESTTOKEN in an OAuth-flow test that exercises the real
  # extraction regex). Exempt test paths from the credential-PATTERN rule
  # only — conflict-marker and *.local.md checks above still apply. Mirrors
  # how gitleaks/trufflehog allowlist test paths; real secrets live in
  # product code, not fixtures.
  case "$file" in
    */tests/*|*/test/*|*/__tests__/*|*/testdata/*|*/fixtures/*)
      continue ;;
  esac
  if echo "$blob" | grep -qE "$cred_pattern"; then
    printf "  %s (credential pattern — move secrets to .datacore/env/)\n" "$file" >> "$sfile"
  fi
done

# --- C. Org tag validity ------------------------------------------------------
# Org tags may contain ONLY [a-zA-Z0-9_@#%]. One invalid tag voids the ENTIRE
# trailing tag string on that heading — siblings included — so the heading looks
# correctly tagged in the file and answers no query. That is how 343 headings
# accumulated unnoticed across 20 files before 2026-07-27.
#
# This is the backstop that makes the class of bug non-recurring: it does not
# matter which writer produced the line (a script, an agent, a hand edit), an
# invalid org tag cannot reach a commit. Canonical kebab-case is still correct
# for markdown #tags — only the org spelling must use underscores
# (tag_utils.to_org_tag).
tagfile=$(mktemp)
trap 'rm -f "$vfile" "$sfile" "$tagfile"' EXIT
echo "$staged" | while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in *.org) ;; *) continue ;; esac
  git show ":$file" 2>/dev/null | awk -v f="$file" '
    /^\*+[ \t]/ {
      line = $0
      # Strip org links first — their URLs are full of colons.
      gsub(/\[\[[^]]*\](\[[^]]*\])?\]/, " ", line)
      # Trailing tag string: :a:b:c: at end of line.
      if (match(line, /:[^ \t:]+(:[^ \t:]+)*:[ \t]*$/)) {
        tags = substr(line, RSTART, RLENGTH)
        gsub(/[ \t]+$/, "", tags)
        n = split(substr(tags, 2, length(tags) - 2), parts, ":")
        for (i = 1; i <= n; i++) {
          if (parts[i] != "" && parts[i] !~ /^[A-Za-z0-9_@#%]+$/) {
            printf "  %s:%d  invalid org tag \"%s\" (voids ALL tags on this heading)\n", f, NR, parts[i]
          }
        }
      }
    }' >> "$tagfile"
done

fail=0
if [ -s "$tagfile" ]; then
  printf "\033[1;31mINVALID ORG TAGS\033[0m\n\n"
  cat "$tagfile"
  printf "\nOrg tags allow only [a-zA-Z0-9_@#%%] — a hyphen silently voids every tag\n"
  printf "on the heading. Repair with:\n"
  printf "  python3 .datacore/lib/org_tag_normalize.py --dry-run\n"
  printf "  python3 .datacore/lib/org_tag_normalize.py --apply\n"
  fail=1
fi
if [ -s "$vfile" ]; then
  printf "\033[1;31mSTRUCTURAL INTEGRITY VIOLATION\033[0m\n"
  printf "Files in unexpected root locations:\n\n"
  cat "$vfile"
  printf "\nAllowed root dirs: %s\n" "$ALLOWED_DIRS"
  printf "Grandfathered (this space): %s\n" "$(echo "$extra_allow" | tr '\n' ' ')"
  printf "Move files to the correct DIP-0015 location, or grandfather in .datacore/structure-allow.\n"
  fail=1
fi
if [ -s "$sfile" ]; then
  printf "\033[1;31mSAFETY VIOLATION\033[0m\n\n"
  cat "$sfile"
  fail=1
fi
# Day-of-week names must match their dates.
#
# This is where it actually matters: org files and journals live in the space
# repos, not the root repo. On 2026-08-27 seven `[2026-08-27 Wed]` stamps were
# written into 0-personal/org/inbox.org — a space repo — through a
# `python3 - <<EOF` heredoc, which never touches the Edit/Write PreToolUse hook
# that exists to catch this. The date was a Thursday. The commit is the one
# chokepoint every write path passes through whatever tool produced the bytes.
_dv=""
for _c in "$(git rev-parse --show-toplevel)/.datacore/lib/validate_org_dates.py" \
          "$HOME/Data/.datacore/lib/validate_org_dates.py"; do
  [ -f "$_c" ] && { _dv="$_c"; break; }
done
if [ -n "$_dv" ]; then
  if ! python3 "$_dv" --staged; then
    printf "\n\033[1;31mWRONG WEEKDAY\033[0m — a date stamp names a day it is not.\n"
    printf "Repair and re-stage:\n"
    printf "  python3 .datacore/lib/validate_org_dates.py --fix <file> && git add <file>\n"
    fail=1
  fi
fi

# A staged roadmap.yaml must still validate.
#
# The roadmap is only useful because it is checkable, and a check that does not
# run is a check that does not exist. This is the one chokepoint every edit
# passes through — a heredoc, an agent, or a hand edit all end here. It runs
# ONLY when roadmap.yaml is staged, so it costs nothing on an ordinary commit.
#
# Deliberately NOT running drift or readiness here: both reach the network or
# the whole task pool, which is too slow for a commit and would teach people to
# use --no-verify. Those belong on a cadence.
# The hook runs INSIDE the space repo, so the staged path is `roadmap.yaml`,
# not `5-plur/roadmap.yaml`. Matching the repo-relative form is the whole
# reason the first version of this check silently never fired.
if git diff --cached --name-only | grep -q '^roadmap\.yaml$'; then
  _rv=""
  for _c in "$HOME/Data/.datacore/lib/roadmap_validate.py" \
            "$(git rev-parse --show-toplevel)/../.datacore/lib/roadmap_validate.py"; do
    [ -f "$_c" ] && { _rv="$_c"; break; }
  done
  if [ -n "$_rv" ]; then
    if ! python3 "$_rv" >/dev/null 2>&1; then
      printf "\n\033[1;31mROADMAP INVALID\033[0m — see the errors:\n"
      python3 "$_rv" 2>&1 | tail -20
      fail=1
    fi
  fi
fi

# A staged org file must not queue work an agent cannot execute.
#
# `:AI:` is nightshift's queue, not a label — find_ai_tasks selects exactly the
# headings carrying it in TODO/NEXT. On 2026-09-04 that queue held 92 tasks of
# which 4 named a surface and a definition of done, because the tag had been
# added by hand, by agents and by cadences for months with nothing checking it.
# Normally sprint_sync writes the tag from sprint.yaml and this never fires; it
# exists for the hand-added exception, which is the path that caused the drift.
#
# Same repo-relative rule as the roadmap check above: staged paths are
# `org/next_actions.org`, never `5-plur/org/next_actions.org`.
_staged_org=$(git diff --cached --name-only | grep '^org/.*\.org$' || true)
if [ -n "$_staged_org" ]; then
  _gate=""
  for _c in "$HOME/Data/.datacore/lib/ai_task_gate.py" \
            "$(git rev-parse --show-toplevel)/../.datacore/lib/ai_task_gate.py"; do
    [ -f "$_c" ] && { _gate="$_c"; break; }
  done
  if [ -n "$_gate" ]; then
    if ! python3 "$_gate" $_staged_org; then
      fail=1
    fi
  fi
fi

[ "$fail" = "1" ] && { printf "\nTo bypass (emergency): git commit --no-verify\n"; exit 1; }

exit 0
