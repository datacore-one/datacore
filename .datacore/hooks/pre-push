#!/bin/bash
# Validate committed content before publishing; pass the same refs to Git LFS.
set -euo pipefail
REPO_ROOT=$(git rev-parse --show-toplevel)
VALIDATOR="$REPO_ROOT/.datacore/lib/git_privacy.py"
if [ ! -f "$VALIDATOR" ]; then
    VALIDATOR="${DATACORE_ROOT:-$HOME/Data}/.datacore/lib/git_privacy.py"
fi
if [ ! -f "$VALIDATOR" ]; then
    echo "pre-push: validator missing; refusing unvalidated push" >&2
    exit 1
fi
REFS_INPUT=$(cat)
printf '%s\n' "$REFS_INPUT" | python3 "$VALIDATOR" --repo "$REPO_ROOT" --pre-push "$1"
if command -v git-lfs >/dev/null 2>&1; then
    printf '%s\n' "$REFS_INPUT" | git lfs pre-push "$@"
fi
