{
  "mcpServers": {
    "datacore": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/datacore/profile.json",
        "--credentials",
        "/absolute/private/mcp/datacore/secrets.json"
      ]
    },
    "gamma": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/gamma/profile.json",
        "--credentials",
        "/absolute/private/mcp/gamma/secrets.json"
      ]
    },
    "perplexity": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/perplexity/profile.json",
        "--credentials",
        "/absolute/private/mcp/perplexity/secrets.json"
      ]
    },
    "exa": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/exa/profile.json",
        "--credentials",
        "/absolute/private/mcp/exa/secrets.json"
      ]
    },
    "jina": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/jina/profile.json",
        "--credentials",
        "/absolute/private/mcp/jina/secrets.json"
      ]
    },
    "gemini": {
      "command": "/absolute/path/to/qualified/python",
      "args": [
        "-I",
        "/absolute/path/to/datacore/.datacore/lib/mcp_stdio.py",
        "--profile",
        "/absolute/private/mcp/gemini/profile.json",
        "--credentials",
        "/absolute/private/mcp/gemini/secrets.json"
      ]
    }
  }
}
