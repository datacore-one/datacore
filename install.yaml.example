meta:
  name: "My Datacore"
  root: ~/Data
  version: 1.0.0

# Root-level modules (optional)
modules:
  # - repo: datacore/module-core
  #   path: .datacore/modules/core

# Personal space (tracked in root repo)
personal:
  path: 0-personal
  modules: []
    # Example: private trading module
    # - repo: username/module-trading
    #   path: .datacore/modules/trading
    #   private: true

# Team spaces (each is a separate repo)
spaces: {}
  # Example team space:
  # myteam:
  #   repo: org/team-space
  #   path: 1-myteam
  #   modules:
  #     - repo: datacore/module-comms
  #   projects:
  #     - repo: org/project1
  #       path: projects/project1

# Which space holds which duty. Tools ask for a role, never a space by name.
# A role names the SPACE (its config name, or its folder without the number):
# the number in front of a folder is a local sort order and differs per machine,
# so write `myteam`, never `1-myteam`.
# Unset roles are fine: the tool falls back or asks for --space.
roles:
  system: myteam        # where Datacore's own work lives: promises, repair tasks
  product: myteam       # the roadmap, sprints and product triage tools default here
  standup: myteam       # the team space the daily standup posts for
  held: []              # spaces tools must never write to
  attest: [myteam, personal]   # where attestations land, first with a ledger wins
