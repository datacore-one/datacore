meta:
  name: "My Datacore"
  root: ~/Data
  version: 1.0.0

# Root-level modules (optional)
modules:
  # - repo: datacore/module-core
  #   path: .datacore/modules/core

# Personal space (tracked in root repo)
personal:
  path: 0-personal
  modules: []
    # Example: private trading module
    # - repo: username/module-trading
    #   path: .datacore/modules/trading
    #   private: true

# Team spaces (each is a separate repo)
spaces: {}
  # Example team space:
  # myteam:
  #   repo: org/team-space
  #   path: 1-myteam
  #   modules:
  #     - repo: datacore/module-comms
  #   projects:
  #     - repo: org/project1
  #       path: projects/project1

# Which space holds which duty. Tools ask for a role, never a space by name.
# Unset roles are fine: the tool falls back or asks for --space.
roles:
  system: 1-myteam      # where Datacore's own work lives: promises, repair tasks
  product: 1-myteam     # the roadmap, sprints and product triage tools default here
  standup: 1-myteam     # the team space the daily standup posts for
  held: []              # spaces tools must never write to
  attest: [1-myteam, 0-personal]   # where attestations land, first with a ledger wins
